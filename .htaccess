# =====================================================================
#  titanali — پیکربندی هاست سی‌پنل (Apache 2.4 / LiteSpeed)
#  این فایل باید کنار index.html در public_html باشد.
# =====================================================================

# ---------- کدگذاری و صفحه‌ی پیش‌فرض ----------
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes -MultiViews
ServerSignature Off

# ---------- نوع MIME برای manifest و svg (در برخی هاست‌ها لازم است) ----------
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType application/javascript .js

# ---------- الزام HTTPS ----------
# اگر گواهی SSL فعال دارید همین بگذارید؛ اگر نه، این بلوک را # بگذارید.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------- فشرده‌سازی (HTML تک‌فایل ما با gzip ~۷۵٪ کوچک می‌شود) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
  BrowserMatch ^Mozilla/4 gzip-only-text/html
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
# اگر هاست LiteSpeed است، فشرده‌سازی از Web Host Manager / «Optimize Website» هم فعال می‌شود.

# ---------- کش مرورگر (HTML همیشه تازه، فایل‌ها یک سال) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png                       "access plus 1 year"
  ExpiresByType image/svg+xml                   "access plus 1 year"
  ExpiresByType image/jpeg                      "access plus 1 year"
  ExpiresByType application/javascript          "access plus 7 days"
  ExpiresByType application/manifest+json       "access plus 7 days"
  ExpiresByType text/html                       "access plus 0 seconds"
</IfModule>
# ---------- سربرگ‌های امنیتی ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # CSP: اسکریپت و استایل ما درون‌خطی‌اند، پس 'unsafe-inline' لازم است.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://i.instagram.com https://www.instagram.com; font-src 'self' data:; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header unset X-Powered-By
</IfModule>

# ---------- کش LiteSpeed / سرور ----------
# روی بیشتر هاست‌های سی‌پنل LiteSpeed فعال است و اگر اجازه دهیم api.php را
# کش کند، پاسخ صندوق/محتوا برای همه منجمد می‌شود. پس:
<IfModule LiteSpeed>
  CacheLookup off
  <Files "api.php">
    CacheLookup off
  </Files>
</IfModule>
<IfModule mod_expires.c>
  <Files "api.php">
    ExpiresActive Off
    Header set Cache-Control "no-store, max-age=0, must-revalidate"
  </Files>
</IfModule>

# ---------- بسته‌های خطا ----------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ---------- بک‌اند PHP (اختیاری) ----------
# api.php باید از وب قابل اجرا باشد؛ دیتای آن در titanali-data/ است و آن پوشه بسته می‌شود.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^titanali-data/ - [F,L]
  RewriteRule ^dist/ - [F,L]
</IfModule>
<FilesMatch "^titanali-config\.php$">
  Require all denied
</FilesMatch>
# اگر PHP روی هاست خاموش بود، سایت بدون بک‌اند کار می‌کند (فقط محلی).
# برای بستن اجرای PHP در پوشهٔ آپلود (اگر data بیرون از public_html نیست):
# <Directory "titanali-data/uploads">
#   <FilesMatch "\.(php|phtml)$">
#     Require all denied
#   </FilesMatch>
# </Directory>

# ---------- جلوگیری از دسترسی به فایل‌های سرویس و توسعه ----------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "(^#|\.(ini|log|sh|py|php\.bak|bak|sql|zip|gz|tar|md|markdown|lock|tmp)$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/deploy(/|$)
RedirectMatch 404 ^/dist(/|$)
RedirectMatch 404 ^/\.git(/|$)

# ---------- جلوگیری از لو‌تِکِ لینک‌پرِویو اینستاگرام/تلگرام ----------
# ربات‌ها باید به index.html دسترسی داشته باشند؛ چیزی بلاک نشده است.
# اگر خواستید اسکریپت‌ها را ببندید، نمونه:
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_USER_AGENT} (scanner|sqlmap|nikto) [NC,OR]
#   RewriteCond %{HTTP_USER_AGENT} ^-?$
#   RewriteRule .* - [F,L]
# </IfModule>
