<?xml version="1.0" encoding="utf-8"?>
<!-- پیام‌ها/لاگین در WebView localStorage می‌مانند → بیرون از دستگاه نرود -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="webview" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="webview" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
