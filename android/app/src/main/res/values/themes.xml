<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- تم ساده بدون ActionBar؛ پس‌زمینه = رنگ سایت تا موقع loading پرش نباشد -->
    <style name="Theme.Titanali" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorAccent">@color/brand_accent</item>
    </style>
</resources>
